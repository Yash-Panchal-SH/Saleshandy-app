{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/node_modules",
      "!!**/coverage",
      "!!**/test-results",
      "!!**/playwright-report",
      "!src/routeTree.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "a11y": {
        // shadcn/ui Button uses `asChild` to render arbitrary elements (e.g. <a>);
        // the underlying Slot renders whatever element the consumer passes, so
        // useButtonType would be a false-positive for all `asChild` usages.
        // Biome cannot see through the Slot abstraction — disable per SCAF-18.
        "useButtonType": "off"
      },
      "complexity": {
        // `!important` is the standard W3C technique for the `prefers-reduced-motion`
        // accessibility block — it must override any specificity. Disabling globally
        // for CSS; TypeScript/JSX files are unaffected.
        "noImportantStyles": "off"
      },
      "style": {
        // Redux is not used in the rebuild — Zustand owns global UI state.
        // See CONTRIBUTING.md → State management.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "redux": "Use Zustand for global UI state — see CONTRIBUTING.md.",
              "@reduxjs/toolkit": "Use Zustand for global UI state — see CONTRIBUTING.md.",
              "react-redux": "Use Zustand for global UI state — see CONTRIBUTING.md."
            }
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "jsxQuoteStyle": "double"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "allowWrongLineComments": false,
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 100,
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
